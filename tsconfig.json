{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitReturns": true,
    "types": [
      "jest"
    ],
    "paths": {
      "@components/*": [
        "./src/components/*"
      ],
      "@constants": [
        "./src/constants/index.ts"
      ],
      "@hooks": [
        "./src/hooks/index.ts"
      ],
      "@mock/*": [
        "./src/mock/*"
      ],
      "@navigation/*": [
        "./src/navigation/*"
      ],
      "@providers": [
        "./src/providers/index.ts"
      ],
      "@screens": [
        "./src/screens/index.ts"
      ],
      "@services/*": [
        "./src/services/*"
      ],
      "@testing/*": [
        "./src/testing/*"
      ],
      "@theme": [
        "./src/theme/index.ts"
      ],
      "@types": [
        "./src/types/index.ts"
      ],
      "@utils": [
        "./src/utils/index.ts"
      ]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx"
  ]
}
